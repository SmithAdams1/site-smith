{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "smithandadams.com" }],
      "destination": "https://www.smithandadams.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/seo_blog?slug=$1" },
    { "source": "/property/:slug", "destination": "/api/property?slug=$1" },
    { "source": "/p/:slug", "destination": "/api/page?slug=$1" },
    { "source": "/pt/about", "destination": "/api/rd-page?slug=about&locale=pt" },
    { "source": "/pt/invest-in-portugal", "destination": "/api/rd-page?slug=invest-in-portugal&locale=pt" },
    { "source": "/pt/blog/:slug", "destination": "/api/seo_blog?slug=$1&locale=pt" },
    { "source": "/about", "destination": "/api/rd-page?slug=about" },
    { "source": "/about.html", "destination": "/api/rd-page?slug=about" },
    { "source": "/invest-in-portugal", "destination": "/api/rd-page?slug=invest-in-portugal" },
    { "source": "/invest-in-portugal.html", "destination": "/api/rd-page?slug=invest-in-portugal" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 10 * * *"
    }
  ]
}
