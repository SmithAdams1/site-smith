{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "smithandadams.com" }],
      "destination": "https://www.smithandadams.com/:path*",
      "permanent": true
    },
    { "source": "/our-developments", "destination": "/hospitality", "permanent": true },
    { "source": "/our-developments.html", "destination": "/hospitality", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/seo_blog?slug=$1" },
    { "source": "/property/:slug", "destination": "/api/property?slug=$1" },
    { "source": "/p/:slug", "destination": "/api/page?slug=$1" },
    { "source": "/pt/about", "destination": "/api/rd-page?slug=about&locale=pt" },
    { "source": "/pt/invest-in-portugal", "destination": "/api/rd-page?slug=invest-in-portugal&locale=pt" },
    { "source": "/pt/golden-visa", "destination": "/api/rd-page?slug=golden-visa&locale=pt" },
    { "source": "/pt/d2-visa", "destination": "/api/rd-page?slug=d2-visa&locale=pt" },
    { "source": "/pt/portugal-tax", "destination": "/api/rd-page?slug=portugal-tax&locale=pt" },
    { "source": "/pt/blog/:slug", "destination": "/api/seo_blog?slug=$1&locale=pt" },
    { "source": "/pt/property/:slug", "destination": "/api/property?slug=$1&locale=pt" },
    { "source": "/pt", "destination": "/api/pt-static?page=index" },
    { "source": "/pt/our-developments", "destination": "/api/pt-static?page=our-developments" },
    { "source": "/pt/property-management", "destination": "/api/pt-static?page=property-management" },
    { "source": "/pt/contact", "destination": "/api/pt-static?page=contact" },
    { "source": "/pt/real-estate", "destination": "/api/pt-static?page=real-estate" },
    { "source": "/about", "destination": "/api/rd-page?slug=about" },
    { "source": "/about.html", "destination": "/api/rd-page?slug=about" },
    { "source": "/invest-in-portugal", "destination": "/api/rd-page?slug=invest-in-portugal" },
    { "source": "/invest-in-portugal.html", "destination": "/api/rd-page?slug=invest-in-portugal" },
    { "source": "/golden-visa", "destination": "/api/rd-page?slug=golden-visa" },
    { "source": "/golden-visa.html", "destination": "/api/rd-page?slug=golden-visa" },
    { "source": "/d2-visa", "destination": "/api/rd-page?slug=d2-visa" },
    { "source": "/d2-visa.html", "destination": "/api/rd-page?slug=d2-visa" },
    { "source": "/portugal-tax", "destination": "/api/rd-page?slug=portugal-tax" },
    { "source": "/portugal-tax.html", "destination": "/api/rd-page?slug=portugal-tax" },
    { "source": "/real-estate", "destination": "/api/property?list=1" },
    { "source": "/real-estate.html", "destination": "/api/property?list=1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 10 * * *"
    }
  ]
}
