{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/seo_blog?slug=$1" }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 10 * * *"
    }
  ]
}
